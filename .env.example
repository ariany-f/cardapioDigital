APP_NAME=AppCardapio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:4600

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appcardapio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Em produção: true (padrão automático quando APP_ENV=production)
SESSION_ENCRYPT=
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Segurança — em produção use APP_DEBUG=false e HTTPS
SECURITY_ALLOW_PUBLIC_REGISTRATION=false
SECURITY_HEADERS=true
SECURITY_HSTS=true
SECURITY_BLOCK_PROBES=true
SECURITY_FORCE_HTTPS=true
SECURITY_UPLOAD_MAX_KB=5120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SEND_IN_LOCAL=false
MAIL_FROM_ADDRESS="noreply@appcardapio.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

SEED_DEMO=false
SEED_SUPERADMIN_EMAIL=admin@admin.com.br
SEED_SUPERADMIN_PASSWORD=Mudar123@
SEED_DEMO_PASSWORD=password
